# Copie para .env e preencha. O servidor lê este arquivo ao iniciar (npm start).

# Endereço público HTTPS onde a Fmidia roda. Usado nas URLs de retorno do OAuth
# e nos links de mídia que Instagram/Facebook/TikTok baixam.
PUBLIC_URL=https://fmidia.suaempresa.com.br
PORT=3000

# Chave para cifrar os tokens das redes. Gere com: openssl rand -hex 32
# Guarde com segurança: sem ela, os perfis conectados precisam ser reconectados.
FMIDIA_SECRET=

# Meta (Facebook + Instagram) — developers.facebook.com
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_VERSION=v23.0
# META_CONFIG_ID=        # opcional, se usar "Facebook Login for Business"

# TikTok — developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Privacidade dos posts. Antes da auditoria do app, o TikTok só permite SELF_ONLY (privado).
# TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE

# FMIDIA_DB=data/fmidia.db
# FMIDIA_UPLOADS=data/uploads
# FMIDIA_NO_DEMO=1       # não criar a conta demo
